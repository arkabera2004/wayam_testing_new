# Provisioned by the Vercel Marketplace (Neon). Pull with: vercel env pull .env.local --yes
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk — provisioned on the project via the Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Without these, protecting a route 404s instead of redirecting to sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Tenant the seed script writes under. Required, and it must be a real Clerk
# user id (user_...) — reads are scoped to the signed-in user, so seeding under
# anything else creates rows no account can reach. Leave unset for a genuinely
# empty first run, which is the expected new-account experience.
SEED_USER_ID=
