# Provisioned by the Vercel Marketplace (Neon). Pull with: vercel env pull .env.local --yes
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk — provisioned on the project via the Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Without these, protecting a route 404s instead of redirecting to sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Tenant the seed script writes under. Set this to your Clerk user id
# (user_...) and re-run `npm run db:seed` to see the demo project when signed
# in; otherwise a new account starts empty, which is the correct first run.
SEED_USER_ID=demo-user
