# Provisioned by the Vercel Marketplace (Neon). Pull with: vercel env pull .env.local --yes
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk is provisioned on the Vercel project but the app does not use it right
# now — authentication was removed to focus on the testing pipeline. The keys
# stay in the environment so wiring it back is a code change, not a re-provision.

# Tenant everything runs as while authentication is out of the app. The seeded
# project lives under this id; change it and re-seed to work under another.
SEED_USER_ID=demo-user

# Live-browser healing. With no key, healing runs in a local Chromium, which
# costs nothing. With a key, each heal rents a Browser Use cloud session and
# stops it immediately — billing runs until the session stops.
# Set HEAL_BROWSER=local to force local even when a key is present.
BROWSER_USE_API_KEY=
# Or attach to a session you already started, skipping create/stop entirely.
BROWSER_USE_CDP_URL=
