# MongoDB connection string. For local dev, run a local mongod or use an
# Atlas free-tier cluster and paste its connection string here.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="parikshan"

# Used to encrypt/verify anything session-related. Generate your own with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-64-char-hex-string"

# Used by the browser-agent crawl service (services/crawl-agent) for
# browser-use's agent reasoning, and by the GitHub-repo scenario-generation
# pipeline (src/lib/projects/scenario-generation.server.ts) to draft test
# scenarios via Gemini.
GOOGLE_API_KEY=""

# Optional. A GitHub personal access token (repo scope) used only to read a
# repo's file tree/README when generating its test scenarios — no write
# access needed. Without this, generation still works for public repos
# (subject to GitHub's low unauthenticated rate limit) but fails/falls back
# for private ones.
GITHUB_TOKEN=""

# Base URL of the separately-run crawl-agent service (services/crawl-agent).
# The frontend's /projects/new flow calls this over HTTP — see
# src/lib/crawl/functions.ts.
CRAWL_AGENT_URL="http://localhost:8090"
